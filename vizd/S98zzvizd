#!/bin/sh
# S98zzvizd - 可视化服务自启 (vizd :8081) + 雷达镜像 iptables 规则
case "$1" in
start)
    [ -x /userdata/xtapp/vizd ] || exit 0
    iptables -t nat -C OUTPUT -d 192.0.2.200 -p udp --dport 17778 -j REDIRECT --to-ports 17778 2>/dev/null || \
        iptables -t nat -A OUTPUT -d 192.0.2.200 -p udp --dport 17778 -j REDIRECT --to-ports 17778
    pidof vizd >/dev/null 2>&1 || { /userdata/xtapp/vizd >/tmp/vizd.log 2>&1 & }
    echo "vizd started"
    ;;
stop)
    killall vizd 2>/dev/null
    sleep 1
    pidof vizd >/dev/null 2>&1 && killall -9 vizd 2>/dev/null
    while iptables -t nat -D OUTPUT -d 192.0.2.200 -p udp --dport 17778 -j REDIRECT --to-ports 17778 2>/dev/null; do :; done
    echo "vizd stopped"
    ;;
restart)
    $0 stop
    sleep 1
    $0 start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
