{
  "version": 1,
  "sensors": {
    "imu_fps": 0,
    "lidar_fps": 10,
    "image_fps": 10,
    "image_format": 2,
    "h264_gop": 15,
    "h264_bitrate": 8,
    "image_jpeg_source": "transcode"
  },
  "timestamp_mode": "unix_epoch",
  "legacy_compatibility": {
    "enabled": true,
    "legacy_sn": "REPLACE_WITH_UNIQUE_SN",
    "http_port": 8080,
    "image_batch_size": 1,
    "legacy_topics_only": true,
    "strict_setting_response": true,
    "pointcloud_axes": "legacy_x_forward_y_left_z_up"
  },
  "radar_network": {
    "interface": "eth0",
    "source_address": "192.0.2.179"
  },
  "zenoh": {
    "mode": "client",
    "connect": [
      "tcp/127.0.0.1:7447"
    ],
    "listen": [],
    "scouting": {
      "multicast": {
        "enabled": false
      }
    }
  },
  "camera_id": "UNCONFIGURED",
  "fusion_camera_id": "UNCONFIGURED"
}
